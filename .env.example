JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_GENERATIVE_AI_API_KEY=your-google-generative-ai-key
GOOGLE_GENERATIVE_AI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
